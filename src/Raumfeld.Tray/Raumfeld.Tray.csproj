<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationIcon>Assets/raumfeld.ico</ApplicationIcon>
    <Product>Raumfeld Desktop Stream</Product>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Raumfeld.DesktopStream/Raumfeld.DesktopStream.csproj" />
    <EmbeddedResource Include="Assets/raumfeld.ico" />
    <EmbeddedResource Include="Assets/raumfeld.png" />
  </ItemGroup>
  <Target Name="CopyWorkerHost" AfterTargets="Build">
    <ItemGroup>
      <WorkerHost Include="../Raumfeld.DesktopStream/bin/$(Configuration)/$(TargetFramework)/win-x64/Raumfeld.DesktopStream.exe;../Raumfeld.DesktopStream/bin/$(Configuration)/$(TargetFramework)/win-x64/Raumfeld.DesktopStream.runtimeconfig.json;../Raumfeld.DesktopStream/bin/$(Configuration)/$(TargetFramework)/win-x64/Raumfeld.DesktopStream.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkerHost)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
